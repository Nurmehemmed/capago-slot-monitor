# Capago Portal Credentials
CAPAGO_PORTAL_URL=https://appointment-az.capago.eu/
CAPAGO_EMAIL=your_email@example.com
CAPAGO_PASSWORD=your_secure_password

# Target Destination / Center / Category (as seen in Capago wizard)
CAPAGO_CENTER=Baku
CAPAGO_CATEGORY=Tourism
CAPAGO_PURPOSE=Tourism / Private visit
CAPAGO_VARIATION=Schengen
CAPAGO_SITUATION=Tourism / Private visit - Adult

# Applicant Details (Required to navigate Step 3)
APPLICANT_TITLE=Mr
APPLICANT_FIRSTNAME=Nurmahammad
APPLICANT_LASTNAME=Nabiyev
APPLICANT_PASSPORT=A81242122
APPLICANT_DOB=01/01/1995
APPLICANT_PHONE=0517111589
APPLICANT_EMAIL=
APPLICANT_DEPARTURE_DATE=01/12/2026
# If you need Capago form assistance (24 AZN), set to true. No FRA ref needed:
APPLICANT_NEEDS_FRANCE_VISAS_ASSISTANCE=true
# If false, enter your real FRA reference from france-visas.gouv.fr (never use a fake number!):
APPLICANT_FRANCE_VISAS_REF=

# Telegram Bot Alerting Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=your_chat_id_or_channel_id

# Execution & Anti-Detection Timing (in minutes)
MIN_CHECK_INTERVAL_MINUTES=10
MAX_CHECK_INTERVAL_MINUTES=25
MONTHS_TO_SCAN=4

# Browser Configuration
HEADLESS=false
DEBUG_SCREENSHOTS=false
STORAGE_STATE_PATH=./storage/auth_state.json
